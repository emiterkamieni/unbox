<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "binaries": unbox's own files, signed before Velopack packs them.
     The artifact is the folder unsigned/binaries from .github/workflows/windows.yml. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <directory-set>
      <include path="win-x64" />
      <include path="win-arm64" />
      <for-each>
        <pe-file-set product-name="unbox" product-version="${version}">
          <include path="unbox.exe" />
          <include path="unbox.dll" />
          <include path="UnboxKit.dll" />
          <for-each>
            <authenticode-sign />
          </for-each>
        </pe-file-set>
      </for-each>
    </directory-set>
  </zip-file>
</artifact-configuration>
