<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Unbox.Kit</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <!-- Native SQLite with the fix for GHSA-2m69-gcr7-jv3q (2.1.11 and older are affected). -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared with the macOS app: the same catalogs, keyed by the English text. -->
    <Content Include="..\..\..\Resources\Localizations\*.json" Link="Localizations\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
