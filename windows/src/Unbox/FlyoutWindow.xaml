<Window x:Class="Unbox.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Unbox"
        Title="unbox" Width="440" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <Window.Resources>
        <local:InverseVisibilityConverter x:Key="Hidden" />
        <local:NotConverter x:Key="Not" />

        <Style x:Key="Notice" TargetType="Border">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </Style>

        <!-- One item: checkbox, icon, name with the folders above it, size and (on hover) “show in File Explorer”. -->
        <DataTemplate x:Key="ItemRow" DataType="{x:Type local:ItemViewModel}">
            <StackPanel>
                <Border Style="{StaticResource Divider}" Margin="52,0,0,0"
                        Visibility="{Binding IsFirstInGroup, Converter={StaticResource Hidden}}" />
                <Border x:Name="Row" Height="44" Margin="3,2" CornerRadius="5" Background="Transparent"
                        MouseLeftButtonUp="OnRowClick">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding KeepOffline}" ToolTip="{Binding CheckboxTooltip}" AutomationProperties.Name="{Binding Name}"
                                  VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="0" Padding="0"
                                  IsEnabled="{Binding DataContext.CanChangeOfflineState, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <TextBlock x:Name="Icon" Grid.Column="1" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                   FontSize="16" Margin="6,0,10,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" ToolTip="{Binding FullPath}">
                            <TextBlock x:Name="NameText" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subpath}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding HasSubpath, Converter={StaticResource Visible}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,10,0">
                            <TextBlock x:Name="SizeText" Text="{Binding SizeText}" ToolTip="{Binding SizeTooltip}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding ShowsSize, Converter={StaticResource Visible}}" />
                            <Button x:Name="Reveal" Style="{StaticResource RevealButton}" Content="&#xE721;" Margin="8,0,0,0"
                                    Visibility="Collapsed" ToolTip="{Binding RevealTooltip}" AutomationProperties.Name="{Binding RevealTooltip}"
                                    Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                            <ProgressBar x:Name="Working" IsIndeterminate="True" Width="36" Height="4" Visibility="Collapsed" />
                            <TextBlock x:Name="ActivityIcon" Text="{Binding ActivityGlyph}" FontFamily="{StaticResource IconFont}"
                                       FontSize="14" Visibility="Collapsed" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, ElementName=Row}" Value="True" />
                        <Condition Binding="{Binding ShowsSize}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Reveal" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding KeepOffline}" Value="False">
                    <Setter TargetName="NameText" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Setter TargetName="SizeText" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Activity}" Value="Working">
                    <Setter TargetName="Working" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Activity}" Value="Waiting">
                    <Setter TargetName="ActivityIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Activity}" Value="Done">
                    <Setter TargetName="ActivityIcon" Property="Visibility" Value="Visible" />
                    <Setter TargetName="ActivityIcon" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Activity}" Value="Failed">
                    <Setter TargetName="ActivityIcon" Property="Visibility" Value="Visible" />
                    <Setter TargetName="ActivityIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <StackPanel>
        <!-- Header -->
        <DockPanel Margin="16,12,10,11">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Content="&#xE8CB;" ToolTip="{Binding SortTooltip}" AutomationProperties.Name="{Binding SortTooltip}" Click="OnSortClick"
                        Visibility="{Binding ShowsSort, Converter={StaticResource Visible}}" />
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="{Binding RefreshTooltip}" AutomationProperties.Name="{Binding RefreshTooltip}"
                        Command="{Binding RefreshNowCommand}"
                        Visibility="{Binding ShowsList, Converter={StaticResource Visible}}" />
                <Button Style="{StaticResource IconButton}" Content="{Binding SettingsGlyph}" ToolTip="{Binding SettingsTooltip}" AutomationProperties.Name="{Binding SettingsTooltip}"
                        Command="{Binding ToggleSettingsCommand}" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <Path Data="{StaticResource LogoGeometry}" Fill="{StaticResource BrandBlue}" Stretch="Uniform"
                      Height="15" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding HeaderSubtitle}" Style="{StaticResource Caption}" Margin="0,5,0,0"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>
        <Border Style="{StaticResource Divider}" />

        <!-- List -->
        <StackPanel Visibility="{Binding ShowsList, Converter={StaticResource Visible}}">
            <Border Style="{StaticResource Notice}" Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                    Visibility="{Binding ShowsUpdateNotice, Converter={StaticResource Visible}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{Binding UpdateNoticeButton}" Command="{Binding InstallUpdateCommand}"
                            Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource Hidden}}" Margin="10,0,0,0" />
                    <TextBlock DockPanel.Dock="Left" Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="15"
                               Foreground="{StaticResource BrandBlue}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Updates.StatusText}" TextWrapping="Wrap" />
                        <ProgressBar Value="{Binding Updates.Progress}" Maximum="100" Height="4" Margin="0,6,0,0"
                                     Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Notice}" Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                    Visibility="{Binding HasLoadError, Converter={StaticResource Visible}}">
                <DockPanel>
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               Margin="0,1,10,0" />
                    <TextBlock Text="{Binding LoadError}" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Notice}" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    Visibility="{Binding ShowsBoxNotRunning, Converter={StaticResource Visible}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{Binding OpenBoxText}" Command="{Binding OpenBoxCommand}" Margin="10,0,0,0" />
                    <TextBlock Text="&#xE769;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding BoxNotRunningText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Nothing offline -->
            <StackPanel Margin="24,36" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
                <TextBlock Text="&#xE753;" FontFamily="{StaticResource IconFont}" FontSize="30" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Caption}" FontSize="13" Margin="0,10,0,0"
                           TextAlignment="Center" />
            </StackPanel>

            <ScrollViewer x:Name="ListScroller" MaxHeight="520" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasItems, Converter={StaticResource Visible}}">
                <ItemsControl ItemsSource="{Binding Groups}" Margin="12,12,12,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:GroupViewModel}">
                            <StackPanel Margin="0,0,0,14">
                                <DockPanel Margin="4,0,4,6">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DockPanel>
                                <Border Style="{StaticResource Card}">
                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ItemRow}" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Footer -->
            <Border Style="{StaticResource Divider}" />
            <StackPanel Margin="16,10,16,12">
                <Border x:Name="BannerBox" CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                        Visibility="{Binding HasBanner, Converter={StaticResource Visible}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Banner.Kind}" Value="Warning">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Banner.Kind}" Value="Failure">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="10"
                                Content="&#xE711;" ToolTip="{Binding CloseText}" AutomationProperties.Name="{Binding CloseText}" Command="{Binding DismissBannerCommand}"
                                VerticalAlignment="Top" Margin="8,-2,-4,0" />
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Banner.Glyph}" FontFamily="{StaticResource IconFont}"
                                   Margin="0,2,8,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Banner.Kind}" Value="Warning">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Banner.Kind}" Value="Failure">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Banner.Message}" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <DockPanel Visibility="{Binding IsApplying, Converter={StaticResource Visible}}">
                    <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="40" Height="4" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding ApplyingText}" TextWrapping="Wrap" />
                </DockPanel>

                <StackPanel Visibility="{Binding ShowsSelectionBar, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding OfflineWarning}" Style="{StaticResource Caption}" Margin="0,0,0,8"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Visibility="{Binding ShowsOfflineWarning, Converter={StaticResource Visible}}" />
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{Binding CancelText}" Command="{Binding CancelSelectionCommand}" IsCancel="True" Margin="0,0,8,0" />
                            <Button Content="{Binding ApplyText}" Command="{Binding ApplyCommand}" IsDefault="True"
                                    Style="{StaticResource AccentButton}" IsEnabled="{Binding IsBoxRunning}" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectionSizeText}" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>

                <DockPanel Visibility="{Binding ShowsHint, Converter={StaticResource Visible}}">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding LastRefreshText}" FontSize="12" Margin="8,0,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding FooterHint}" Style="{StaticResource Caption}" />
                </DockPanel>
            </StackPanel>
        </StackPanel>

        <!-- Settings -->
        <StackPanel Margin="16,12,16,14" Visibility="{Binding ShowingSettings, Converter={StaticResource Visible}}">
            <DockPanel Style="{StaticResource SettingRow}">
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding LaunchAtLogin}" AutomationProperties.Name="{Binding LaunchAtLoginText}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding LaunchAtLoginText}" VerticalAlignment="Center" />
            </DockPanel>

            <DockPanel Style="{StaticResource SettingRow}" Margin="0,6,0,0">
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding FreeSpace}" AutomationProperties.Name="{Binding FreeSpaceText}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding FreeSpaceText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
            </DockPanel>
            <TextBlock Text="{Binding FreeSpaceCaption}" Style="{StaticResource Caption}" Margin="0,2,52,0" />

            <DockPanel Style="{StaticResource SettingRow}" Margin="0,12,0,0">
                <ComboBox DockPanel.Dock="Right" MinWidth="110" ItemsSource="{Binding RefreshChoices}" AutomationProperties.AutomationId="RefreshChoice" AutomationProperties.Name="{Binding RefreshEveryText}" DisplayMemberPath="Title"
                          SelectedValuePath="Value" SelectedValue="{Binding RefreshMinutes}" />
                <TextBlock Text="{Binding RefreshEveryText}" VerticalAlignment="Center" />
            </DockPanel>

            <DockPanel Style="{StaticResource SettingRow}" Margin="0,8,0,0">
                <ComboBox DockPanel.Dock="Right" MinWidth="160" ItemsSource="{Binding LanguageChoices}" AutomationProperties.AutomationId="LanguageChoice" AutomationProperties.Name="{Binding LanguageText}" DisplayMemberPath="Title"
                          SelectedValuePath="Value" SelectedValue="{Binding Language}" MaxDropDownHeight="420" />
                <TextBlock Text="{Binding LanguageText}" VerticalAlignment="Center" />
            </DockPanel>

            <Border Style="{StaticResource Divider}" Margin="0,14" />

            <DockPanel Style="{StaticResource SettingRow}">
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding NotifyAboutUpdates}" AutomationProperties.Name="{Binding NotifyText}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding NotifyText}" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{Binding NotifyCaption}" Style="{StaticResource Caption}" Margin="0,2,52,0" />

            <DockPanel Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" Content="{Binding UpdateButtonText}" Command="{Binding CheckForUpdatesCommand}"
                        VerticalAlignment="Center" IsEnabled="{Binding Updates.IsBusy, Converter={StaticResource Not}}" />
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding VersionText}" />
                    <TextBlock Text="{Binding Updates.StatusText}" Style="{StaticResource Caption}" />
                    <ProgressBar Value="{Binding Updates.Progress}" Maximum="100" Height="4" Margin="0,6,0,0"
                                 Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource Visible}}" />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource Divider}" Margin="0,14" />

            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{Binding DoneText}" Command="{Binding CloseSettingsCommand}"
                        Style="{StaticResource AccentButton}" MinWidth="80" />
                <Button DockPanel.Dock="Left" Content="{Binding QuitText}" Command="{Binding QuitCommand}" HorizontalAlignment="Left" />
            </DockPanel>
        </StackPanel>
    </StackPanel>
</Window>
