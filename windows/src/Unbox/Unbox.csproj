<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>unbox</AssemblyName>
    <RootNamespace>Unbox</RootNamespace>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>Unbox.Program</StartupObject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The Fluent theme (ThemeMode) is still marked experimental in WPF. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\UnboxKit\UnboxKit.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\*.ico" />
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <!-- App.xaml is a plain page: Program.Main starts Velopack before WPF. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>
</Project>
